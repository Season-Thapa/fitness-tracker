@model GoalRequestDto

<h2>Edit Goal</h2>
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Target:</label>
        <input asp-for="Target" type="number" />
        <span asp-validation-for="Target"></span>
    </div>
    <button type="submit">Save Changes</button>
</form>

