@model IEnumerable<GoalDto>

<div class="container mt-4">
    <h2 class="mb-4">Goals</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Target</th>
                <th>Progress</th>
                <th>User ID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var goal in Model)
            {
                <tr>
                    <td>@goal.Target</td>
                    <td>@goal.Progress</td>
                    <td>@goal.UserId</td>
                </tr>
            }
        </tbody>
    </table>
</div>
