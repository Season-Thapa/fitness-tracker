@model IEnumerable<GoalResponseDto>

<h2>User Goals</h2>

<a class="nav-link" asp-area="" asp-controller="Goals" asp-action="Add">Add new Goal</a>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<h3>In Progress Goals</h3>
@if (ViewBag.InProgressGoals != null && ViewBag.InProgressGoals.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Goal</th>
                <th>Progress</th>
                <th>Target</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var goal in ViewBag.InProgressGoals)
            {
                <tr>
                    <td>@goal.Description</td>
                    <td>@goal.Progress</td>
                    <td>@goal.Target</td>
                    <td>
                        <a class="nav-link" asp-area="" asp-route-id="@goal.Id" asp-controller="Goals" asp-action="Update">Edit</a>
                        <form method="post" action="/Goals/Delete/@goal.Id" style="display:inline-block;">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                        <form asp-action="UpdateProgress" method="post">
                            <input type="hidden" name="id" value="@goal.Id" />
                            <input type="number" name="progress" placeholder="Add Progress" min="1" class="form-control" />
                            <button type="submit" class="btn btn-primary">Update</button>
                        </form>


                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No goals in progress.</p>
}

<h3>Completed Goals</h3>
@if (ViewBag.CompletedGoals != null && ViewBag.CompletedGoals.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Goal</th>
                <th>Progress</th>
                <th>Target</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var goal in ViewBag.CompletedGoals)
            {
                <tr>
                    <td>@goal.Description</td>
                    <td>@goal.Progress</td>
                    <td>@goal.Target</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No completed goals.</p>
}

