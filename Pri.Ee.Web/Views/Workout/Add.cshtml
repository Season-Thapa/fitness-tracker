@model WorkoutRequestDto

<h2>Create Workout</h2>
<form method="post">
    <div>
        <label>Type:</label>
        <input asp-for="Type" />
        <span asp-validation-for="Type"></span>
    </div>
    <div>
        <label>Date:</label>
        <input asp-for="Date" />
        <span asp-validation-for="Date"></span>
    </div>
    <button type="submit">Create</button>
</form>