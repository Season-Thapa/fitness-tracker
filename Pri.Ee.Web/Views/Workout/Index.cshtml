@model IEnumerable<WorkoutDto>

<div class="container mt-4">
    <h2 class="mb-4">ClientsWorkouts</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Type</th>
                <th>Duration (mins)</th>
                <th>Calories Burned</th>
                <th>Date</th>
                <th>UserId</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var workout in Model)
            {
                if (workout != null)
                {
                    <tr>
                        <td>@workout.Type</td>
                        <td>@workout.Duration</td>
                        <td>@workout.CaloriesBurned</td>
                        <td>@workout.Date.ToString("yyyy-MM-dd")</td>
                        <td>@workout.UserId</td>
                 
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
