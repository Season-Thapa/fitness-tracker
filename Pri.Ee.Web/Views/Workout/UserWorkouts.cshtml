@model IEnumerable<WorkoutResponseDto>

<div class="container mt-4">
    <h2 class="mb-4">Workouts</h2>

    <div class="mb-3">
        <a class="btn btn-primary" asp-area="" asp-controller="Workout" asp-action="Add">Create New Workout</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Type</th>
                <th>Duration (mins)</th>
                <th>Calories Burned</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var workout in Model)
                {
                    <tr>
                        <td>@workout.Type</td>
                        <td>@workout.Duration</td>
                        <td>@workout.CaloriesBurned</td>
                        <td>@workout.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a class="btn btn-sm btn-warning" asp-area="" asp-route-id="@workout.Id" asp-controller="Workout" asp-action="Update">
                                Edit
                            </a>
                            <form method="post" action="/Workout/Delete/@workout.Id" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No workouts found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
