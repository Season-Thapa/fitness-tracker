@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 text-primary mb-4">FitnessTracker</h1>
        <p class="lead text-muted">Welcome to FitnessTracker, your personal fitness companion.</p>
        <p class="text-muted">Start tracking your workouts and goals with ease!</p>

        @if (User.Identity.IsAuthenticated == false)
        {
            <div class="mt-4">
                <div class="btn-group">
                    <a asp-controller="Accounts" asp-action="Login" class="btn btn-lg btn-outline-primary">Login</a>
                    <a asp-controller="Accounts" asp-action="Register" class="btn btn-lg btn-outline-info">Register</a>
                </div>
            </div>
        }
        </div>

