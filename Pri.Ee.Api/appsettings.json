{
  "ConnectionStrings": {
    "DefaultDatabase": "Server=(localdb)\\mssqllocaldb;Database=FitnessTracker;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JWTConfiguration": {
    "Issuer": "https://localhost:7190",
    "Audience": "https://localhost:7190", //Opgepast; indien je API op een andere poort draait moet je poort 5001 hier veranderen naar je eigen poortnummer
    "SigningKey": "YourSuperStrongSecretKey123456789!",
    "TokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
